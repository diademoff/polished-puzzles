<?xml version="1.0" encoding="utf-8"?>
<!--
  The line between two settings sections. The outline role is the
  lightest neutral role that reaches the 3:1 UI contrast minimum, so a
  section boundary stays visible; outlineVariant is only 1.62:1 on the
  light surface and 1.99:1 on the dark one.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <solid android:color="?attr/colorOutline" />
    <size
        android:height="1dp"
        android:width="1dp" />
</shape>
