<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="PrefsTheme" parent="PreferenceThemeOverlay">
        <item name="android:layout">@layout/prefs</item>
    </style>

    <!-- The completed-game prompt is a bottom panel, not a modal dialog.
         It does not dim the board, so the finished game stays visible. -->
    <style name="Dialog.Completed" parent="Theme.Material3.DayNight.Dialog">
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>
</resources>
