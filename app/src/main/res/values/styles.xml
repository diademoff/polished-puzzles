<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="PrefsTheme" parent="PreferenceThemeOverlay">
        <item name="android:layout">@layout/prefs</item>
        <!-- The Material styles of the preference subclasses leave the
             title single-line, which ellipsizes it at large text sizes.
             Every row must wrap its title instead. -->
        <item name="singleLineTitle">false</item>
    </style>

    <!-- The completed-game prompt is a bottom panel, not a modal dialog.
         It does not dim the board, so the finished game stays visible. -->
    <style name="Dialog.Completed" parent="Theme.SgTPuzzles">
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>
</resources>
