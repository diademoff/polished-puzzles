<?xml version="1.0" encoding="utf-8"?>
<!--
  The prompt shown when a game is completed. It is anchored to the bottom
  and does not block the board completely, so the user can still see the
  finished state.
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/space_s"
    app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
    app:cardCornerRadius="28dp"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_m">

        <TextView
            android:id="@+id/completedTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:paddingBottom="@dimen/space_s"
            android:text="@string/COMPLETED"
            android:textAppearance="?attr/textAppearanceTitleLarge" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/new_game"
                style="@style/Widget.Material3.Button.TextButton.Icon"
                android:layout_width="0dp"
                android:layout_height="96dp"
                android:layout_weight="1"
                android:text="@string/New_game"
                app:icon="@drawable/ic_action_new"
                app:iconGravity="textTop" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/type_menu"
                style="@style/Widget.Material3.Button.TextButton.Icon"
                android:layout_width="0dp"
                android:layout_height="96dp"
                android:layout_weight="1"
                android:text="@string/Change_type"
                app:icon="@drawable/ic_action_type"
                app:iconGravity="textTop" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/other_game"
                style="@style/Widget.Material3.Button.TextButton.Icon"
                android:layout_width="0dp"
                android:layout_height="96dp"
                android:layout_weight="1"
                android:text="@string/Other_game"
                app:icon="@drawable/ic_action_view_as_list"
                app:iconGravity="textTop" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
